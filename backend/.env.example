ENVIRONMENT=development
DATABASE_URL=postgresql+pg8000://sentinel:replace_me@localhost:5432/sentinel
# Local Docker PostgreSQL does not offer SSL; remote/production PostgreSQL must set this to true.
DB_SSL_ENABLED=false
JWT_SECRET=replace-with-a-unique-random-32-plus-character-value
CORS_ORIGINS=http://localhost:3000
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TIMEOUT_SECONDS=30
SARVAM_UPLOAD_IDLE_TIMEOUT_SECONDS=10
SARVAM_UPLOAD_MAX_DURATION_SECONDS=120
